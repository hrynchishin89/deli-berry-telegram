FROM node:24-alpine
WORKDIR /app
COPY deli-berry-miniapp-1.1.1.tar.gz ./release.tar.gz
RUN echo "06268d372cad41d5ff3d795c9b3e58471b765c8ddd77ef9652d24792b95841c2  release.tar.gz" | sha256sum -c - \
    && tar -xzf release.tar.gz -C /app && rm release.tar.gz
WORKDIR /app/source
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8080
USER node
EXPOSE 8080
CMD ["node", "server.mjs"]
